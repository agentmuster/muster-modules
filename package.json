{
  "name": "muster-modules",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-sdk.mjs",
    "link-sdk": "node scripts/link-sdk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/*/test/*.test.ts templates/*/test/*.test.ts",
    "check": "node scripts/check-registry.mjs && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
